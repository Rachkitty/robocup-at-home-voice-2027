<?xml version="1.0"?>
<package format="3">
  <name>robocup_tts</name>
  <version>0.1.0</version>
  <description>Offline speech synthesis using a user-provided Piper voice.</description>
  <maintainer email="maintainers@example.invalid">RoboCup voice maintainers</maintainer>
  <license>MIT</license>
  <buildtool_depend>python3-setuptools</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
